# Ghostty Configuration
# ~/.config/ghostty/config

# ==================== APPEARANCE ====================
# Kanagawa Dragon theme
background = 181819
foreground = dcd7ba

# Kanagawa Dragon Colors
palette = 0=#0d0c0c
palette = 1=#c34043
palette = 2=#76946a
palette = 3=#c0a36e
palette = 4=#7e9cd8
palette = 5=#938aa9
palette = 6=#7fb4ca
palette = 7=#c8c093
palette = 8=#a6a69c
palette = 9=#e82828
palette = 10=#98bb6c
palette = 11=#e6c384
palette = 12=#7ea8fd
palette = 13=#938aa9
palette = 14=#7fb4ca
palette = 15=#f2ccff

# Cursor
cursor-style = block
cursor-style-blink = true
cursor-opacity = 0.8

# ==================== FONT ====================
font-family = JetBrains Mono
# font-family = Source Code Pro
# font-family = FiraCode
# font-family = Hack

font-size = 12
font-thicken = false

# ==================== WINDOW ====================
# Window decorations
window-decoration = false

# Padding
window-padding-x = 12
window-padding-y = 8

# Title bar (macOS only)
macos-titlebar-style = transparent

# ==================== SHELL INTEGRATION ====================
shell-integration = fish
shell-integration-features = cursor,sudo,title

# ==================== BEHAVIOR ====================
# Copy on select
copy-on-select = true

# Scrollback
scrollback-limit = 3000

# Mouse
mouse-hide-while-typing = true

# ==================== KEYBINDINGS ====================
# Split panes (tmux style)
keybind = ctrl+shift+d=new_split:right
keybind = ctrl+shift+s=new_split:down

# Create new tab
keybind = ctrl+shift+t=new_tab

# Navigate tabs
keybind = ctrl+shift+]=next_tab
keybind = ctrl+shift+[=previous_tab

# ==================== SYSTEM INTEGRATION ====================
# Shell
# macOS: command = /opt/homebrew/bin/fish
command = /usr/bin/fish

# Environment variables
env = TERM=ghostty

# ==================== MISC ====================
# Confirm close with unsaved content
confirm-close-surface = false

# Automatic updates
auto-update = check
# auto-update = off

# ==================== MACOS SPECIFIC ====================
macos-option-as-alt = false

